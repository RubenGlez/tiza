{
  "name": "tiza",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "benchmark": "pnpm build && pnpm --filter ca-mcp-reproduction-example benchmark",
    "release:core": "node scripts/release.mjs core",
    "release:mcp": "node scripts/release.mjs mcp"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16"
  }
}
