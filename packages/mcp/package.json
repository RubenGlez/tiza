{
  "name": "@tiza/mcp",
  "version": "0.3.2",
  "description": "MCP server for the Tiza shared context store",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tiza-mcp": "dist/server.js"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tiza/core": "^0.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
